{
  "name": "ring",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "駅を囲む、見えない輪。自転車を停める前に、撤去されるかどうかを教えるサービス。",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --noEmit false --emitDeclarationOnly false",
    "etl": "tsx scripts/etl/index.ts",
    "etl:zones": "tsx scripts/etl/zones.ts",
    "promote": "tsx scripts/promote-zones.ts"
  },
  "dependencies": {
    "@turf/boolean-point-in-polygon": "^7.2.0",
    "@turf/distance": "^7.2.0",
    "@turf/helpers": "^7.2.0",
    "@turf/nearest-point-on-line": "^7.2.0",
    "@turf/polygon-to-line": "^7.2.0",
    "maplibre-gl": "^5.6.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.16",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.1",
    "csv-parse": "^5.6.0",
    "exceljs": "^4.4.0",
    "iconv-lite": "^0.6.3",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vite-plugin-pwa": "^1.0.2",
    "vitest": "^3.2.4"
  }
}
